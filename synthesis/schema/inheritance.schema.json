{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://faultynode.github.io/commentaries/synthesis/schema/inheritance.schema.json",
  "title": "Inheritance record",
  "description": "Stage 3. Same corpus, different question: where does the author engage a predecessor, and in what mode. The mode column is what turns a citation list into a genealogy, so it is required and closed.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "commentary",
    "source_sha256",
    "extracted_at",
    "coverage",
    "engagements"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "commentary": { "type": "string", "pattern": "^[a-z0-9-]+$" },
    "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "extracted_at": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "extractor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "prompt"],
      "properties": {
        "agent": { "type": "string" },
        "prompt": { "type": "string" },
        "note": { "type": "string" }
      }
    },
    "coverage": { "type": "string", "enum": ["complete", "partial"] },
    "coverage_note": { "type": "string" },
    "engagements": { "type": "array", "items": { "$ref": "#/$defs/engagement" } }
  },
  "$defs": {
    "engagement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "locator", "predecessor", "mode", "claim", "quote"],
      "properties": {
        "id": { "type": "string", "pattern": "^inh/[a-z0-9-]+/[0-9]{3}$" },
        "locator": { "type": "string", "pattern": "^[a-z0-9-]+#[a-z0-9-]+$" },
        "primary_locator": { "type": "string" },
        "stratum": { "type": "string" },
        "predecessor": {
          "type": "object",
          "additionalProperties": false,
          "required": ["author"],
          "properties": {
            "author": { "type": "string" },
            "text": {
              "type": "string",
              "description": "The predecessor text, only where the commentary identifies it. Omit rather than infer."
            }
          }
        },
        "mode": {
          "type": "string",
          "enum": [
            "silent-appropriation",
            "acknowledged-debt",
            "polemical-rejection",
            "terminological-borrowing",
            "destructive-appropriation"
          ],
          "description": "The last value is a local addition: Destruktion takes over a concept and dismantles its received sense in one move, which neither rejection nor borrowing describes. Use it only where the commentary presents both halves."
        },
        "claim": { "type": "string", "minLength": 12, "maxLength": 400 },
        "quote": { "type": "string", "minLength": 24, "maxLength": 400 }
      }
    }
  }
}
