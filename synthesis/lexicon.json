  "schema_version": 1,
  "sources": [
    {
      "id": "corpus",
      "kind": "commentary-corpus",
      "citation": "commentaries/*/*.md, via synthesis/corpus.json",
      "note": "A commentary in this corpus states the pairing in its own text, usually as 'English (Original)'. These renderings carry a locator and are re-checked by scripts/synthesis_lexicon.py --check, which is why they are the only kind the machine can verify. They are also the only kind that proves a rendering is actually in use here rather than merely available."
    },
    {
      "id": "repo-registry",
      "kind": "registry",
      "citation": "synthesis/themes.json, scripts/synthesis_query.py, commentaries/CLAUDE.md",
      "note": "Terms this repository already asserted before the lexicon existed. Migrated rather than re-derived, so the seed carries no outside knowledge: every one of these was already in a file under version control. Unverifiable in the sense that no locator points at a commentary using it - but not unsourced."
    }
  ],
