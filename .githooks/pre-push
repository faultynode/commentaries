#!/usr/bin/env bash
# Blocks a push if any outgoing commit trips scripts/check_pii.py
# (real name/email, personal machine paths, secret-shaped strings).
#
# This directory is tracked but git only runs hooks from a path set via
# `core.hooksPath`. Activate it once per clone with:
#   git config core.hooksPath .githooks
set -e

zero="0000000000000000000000000000000000000000"
toplevel="$(git rev-parse --show-toplevel)"
failed=0

while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$zero" ] && continue  # deleting a ref, nothing to check

  if [ "$remote_sha" = "$zero" ]; then
    range_args=("$local_sha" "--not" "--remotes=origin")
  else
    range_args=("$remote_sha..$local_sha")
  fi

  if ! python "$toplevel/scripts/check_pii.py" "${range_args[@]}"; then
    failed=1
  fi
done

if [ "$failed" -ne 0 ]; then
  echo "pre-push: blocked (see above). Fix, amend, or rebase the flagged commit(s) before pushing." >&2
  exit 1
fi

exit 0
